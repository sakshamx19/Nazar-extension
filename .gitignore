# Track only the extension, its docs and the release zip. Everything else in ProjectOG stays local.
/*
!/.gitignore
!/README.md
!/nazar/
!/docs/
!/release/

# Inside nazar: no installs, build output or OS / editor clutter
nazar/node_modules/
nazar/dist/
nazar/*.zip
nazar/*.crx
nazar/*.pem
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log

# Tests and their Blinkit fixtures stay local (not published)
nazar/tests/
nazar/tools/fetch-fixtures.js
